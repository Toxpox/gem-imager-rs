# Copy this file to /etc/udev/rules.d/
# If rules fail to reload automatically, you can refresh udev rules
# with the command "udevadm control --reload"

# T3-GEM-O1 in DFU / USB boot mode (TI AM62x ROM, 0451:6165).
#
# Without this, opening the DFU interface as a normal user fails with EACCES and the
# application can only report "Permission denied for the board" (gem_i18n::Msg::DfuPermissionBody),
# which points the user at exactly this file.
SUBSYSTEM=="usb", ATTR{idVendor}=="0451", ATTR{idProduct}=="6165", MODE="0660", TAG+="uaccess"
