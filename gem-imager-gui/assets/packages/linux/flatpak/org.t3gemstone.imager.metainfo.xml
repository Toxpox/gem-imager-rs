<?xml version="1.0" encoding="utf-8"?>

<component type="desktop-application">
	<id>org.t3gemstone.imager</id>

	<name>T3 Gemstone Imager</name>
	<name xml:lang="tr">T3 Gemstone Imager</name>
	<summary>Write T3 Gemstone OS images to SD cards</summary>
	<summary xml:lang="tr">T3 Gemstone işletim sistemi imajlarını SD kartlara yazın</summary>
	<developer id="org.t3gemstone">
		<name>T3 Gemstone Devteam</name>
	</developer>

	<metadata_license>CC0-1.0</metadata_license>
	<project_license>MIT</project_license>

	<description>
		<p>
			The easiest way to install the latest operating system images for your T3 Gemstone board.
		</p>
		<p xml:lang="tr">
			T3 Gemstone kartınız için en güncel işletim sistemi imajlarını kolayca kurun.
		</p>
		<p>
			Preview release: this build writes to SD cards only. eMMC installation over DFU is not
			available yet, and this application is not a replacement for gem-imager.
		</p>
		<p xml:lang="tr">
			Önizleme sürümü: bu yapı yalnız SD kartlara yazar. DFU üzerinden eMMC kurulumu henüz
			kullanılamaz ve bu uygulama gem-imager'ın yerine geçmez.
		</p>
	</description>

	<launchable type="desktop-id">org.t3gemstone.imager.desktop</launchable>

	<branding>
		<color type="primary" scheme_preference="light">#d15d7d</color>
		<color type="primary" scheme_preference="dark">#18224f</color>
	</branding>

	<categories>
		<category>Development</category>
	</categories>

	<url type="homepage">https://docs.t3gemstone.org</url>
	<url type="bugtracker">https://github.com/Toxpox/gem-imager-rs/issues</url>
	<url type="contact">https://docs.t3gemstone.org/en</url>
	<url type="contribute">https://github.com/Toxpox/gem-imager-rs/tree/main?tab=contributing-ov-file</url>
	<url type="vcs-browser">https://github.com/Toxpox/gem-imager-rs</url>

	<content_rating type="oars-1.1" />

	<!--
		Screenshots are deliberately absent. The upstream entries pointed at BeagleBoard captures
		of a user interface this fork no longer ships, and a stale screenshot is worse than none:
		it advertises the wrong product. Faz 9 (packaging and release) captures T3 screenshots and
		restores this block before the store listings go out.
	-->

	<releases>
		<release version="0.9.0" date="2026-08-06">
			<url>https://github.com/Toxpox/gem-imager-rs/releases/tag/0.9.0</url>
		</release>
	</releases>
</component>
